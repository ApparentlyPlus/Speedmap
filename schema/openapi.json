  "openapi": "3.1.0",
  "paths": {
    "/addresses/{address_id}": {
      "get": {
        "description": "Everything filed at one address, with each offer's evidence and freshness.",
        "operationId": "address_addresses__address_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "address_id",
            "required": true,
            "schema": {
              "title": "Address Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Address",
        "tags": [
          "address"
        ]
      }
    },
    "/addresses/{address_id}/options": {
      "get": {
        "description": "What can be bought here, best first, from what is already known.\n\nNothing is asked of an operator on this path. A page that waits eight seconds for three\ncheckers is a page nobody sees the end of, so the stored answer is served at once and\n`known` says, per operator, whether asking would add anything.",
        "operationId": "address_options_addresses__address_id__options_get",
        "parameters": [
          {
            "in": "path",
            "name": "address_id",
            "required": true,
            "schema": {
              "title": "Address Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "need_mbps",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0.0,
                  "maximum": 10000.0,
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "default": "100",
              "title": "Need Mbps"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Options"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Address Options",
        "tags": [
          "address"
        ]
      }
    },
    "/addresses/{address_id}/probe": {
      "post": {
        "description": "Ask the operators that are due, and keep what they say.\n\nOne operator at a time is the caller's choice, and the reason it exists: a checker takes\nbetween two and eight seconds, and three of them behind one request means the reader\nwaits for the slowest before learning anything. Asked separately, each lands when it\nlands.\n\nThe one path here that leaves the building. It is slow by nature, it is a write, and it\nis rate limited at the proxy for the same reasons the report endpoint is.",
        "operationId": "address_probe_addresses__address_id__probe_post",
        "parameters": [
          {
            "in": "path",
            "name": "address_id",
            "required": true,
            "schema": {
              "title": "Address Id",
              "type": "integer"
            }
          },
          {
            "description": "ask only these; omit to ask every operator that is due",
            "in": "query",
            "name": "provider",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ask only these; omit to ask every operator that is due",
              "title": "Provider"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Probed"
                  },
                  "title": "Response Address Probe Addresses  Address Id  Probe Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
