# Copy to .env and adjust. Never commit .env.

# Postgres. Local development uses peer auth over the Unix socket, so no
# password is needed. When deploying, we set a real one.
SPEEDMAP_DSN=postgresql:///speedmap

# Identify the crawler honestly, with a contact URL. Used by every outbound fetch, register and ISP probe alike.
SPEEDMAP_USER_AGENT=speedmap.gr/0.1 (+https://speedmap.gr/about; non-commercial broadband aggregator)

# Be a good citizen: cap concurrency per upstream and rate-limit to <=1 req/s per ISP, jittered, honouring Retry After.
SPEEDMAP_REGISTER_CONCURRENCY=3
SPEEDMAP_REGISTER_DELAY_S=0.35
