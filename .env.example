# copy to .env, never commit it

# peer auth over the socket locally, set a password when deploying
SPEEDMAP_DSN=postgresql:///speedmap

# every outbound fetch identifies itself with a contact URL
SPEEDMAP_USER_AGENT=speedmap.gr/0.1 (+https://speedmap.gr/about; non-commercial broadband aggregator)

# per upstream, <=1 req/s per ISP with jitter, Retry-After honoured
SPEEDMAP_REGISTER_CONCURRENCY=3
SPEEDMAP_REGISTER_DELAY_S=0.35

# ntfy topic for alerts, long and unguessable. Unset they're only logged
# SPEEDMAP_NTFY_URL=https://ntfy.sh/speedmap-<something-long-and-random>
