[Unit]
Description=speedmap.gr read API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
OnFailure=speedmap-alert@%n.service

[Service]
Type=exec
User=speedmap
WorkingDirectory=/opt/speedmap
EnvironmentFile=/opt/speedmap/.env
# no access log, a line per keystroke on an SD card. Only Caddy talks to it, so trust its
# X-Forwarded-For or every reader is 127.0.0.1 to api/throttle.py
ExecStart=/opt/speedmap/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
Slice=speedmap.slice

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M

[Install]
WantedBy=multi-user.target
