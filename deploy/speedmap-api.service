[Unit]
Description=speedmap.gr read API
# the API answers from Postgres and has nothing to say without it
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
# a failure is pushed to the owner's phone (see speedmap-alert@.service)
OnFailure=speedmap-alert@%n.service

[Service]
Type=exec
User=speedmap
WorkingDirectory=/opt/speedmap
EnvironmentFile=/opt/speedmap/.env
# No access log. A journal line per keystroke of every search would be most of what this
# service writes, on an SD card. Errors still get logged, and Caddy can log access.
# Caddy is the only thing that talks to it, so its X-Forwarded-For is trusted. Without that
# every reader is 127.0.0.1 and the per-caller limits in api/throttle.py throttle everyone at once.
ExecStart=/opt/speedmap/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
Slice=speedmap.slice

# reads a database, writes nothing to disk, needs nothing else reachable
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M

[Install]
WantedBy=multi-user.target
