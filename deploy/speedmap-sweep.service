[Unit]
Description=speedmap.gr re-ask about expiring answers
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=speedmap
WorkingDirectory=/opt/speedmap
EnvironmentFile=/opt/speedmap/.env
ExecStart=/opt/speedmap/.venv/bin/python -m probe.sweep
# It paces itself between addresses, so a run is long, idle and polite. Still going at dawn?
# It's done enough. The queue is a query and picks up next time.
TimeoutStartSec=6h
Slice=speedmap.slice

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=512M
