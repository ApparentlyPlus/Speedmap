[Unit]
Description=speedmap.gr re-ask about expiring answers
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=speedmap-alert@%n.service

[Service]
Type=oneshot
User=speedmap
WorkingDirectory=/opt/speedmap
EnvironmentFile=/opt/speedmap/.env
ExecStart=/opt/speedmap/.venv/bin/python -m probe.sweep
# paces itself, a long polite run. Unfinished at dawn is fine, the queue is a query
TimeoutStartSec=6h
Slice=speedmap.slice

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=512M
