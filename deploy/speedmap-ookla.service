[Unit]
Description=speedmap.gr load the latest quarter of measurements
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=speedmap-alert@%n.service

[Service]
Type=oneshot
User=speedmap
WorkingDirectory=/opt/speedmap
EnvironmentFile=/opt/speedmap/.env
# finds the newest published quarter itself, Ookla's delay varies
ExecStart=/opt/speedmap/.venv/bin/python -m ingest.ookla --latest
ExecStart=/opt/speedmap/.venv/bin/python -m publish.run --out /srv/speedmap/tiles/speedmap.pmtiles
TimeoutStartSec=2h
Slice=speedmap.slice

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
# three tile cuts at once, ~0.5 GB at peak
MemoryMax=2G
