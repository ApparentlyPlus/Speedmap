[Unit]
Description=speedmap.gr check the operator checkers still work
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=speedmap-alert@%n.service

[Service]
Type=oneshot
User=speedmap
WorkingDirectory=/opt/speedmap
EnvironmentFile=/opt/speedmap/.env
# non-zero exit when an adapter has rotted
ExecStart=/opt/speedmap/.venv/bin/python -m probe.canary
TimeoutStartSec=15m
Slice=speedmap.slice

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=256M
