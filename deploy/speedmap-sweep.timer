[Unit]
Description=speedmap.gr nightly sweep

[Timer]
OnCalendar=*-*-* 02:30:00
# A Pi that was off at half two still sweeps when it's back, or the addresses nobody visits
# are the ones that never get refreshed.
Persistent=true
# Jittered off the half hour. Three operators asked by everyone's cron at once is how a
# polite job starts looking like an attack.
RandomizedDelaySec=45m

[Install]
WantedBy=timers.target
