# Pages, API and tiles. Pages never cached, hashed assets cached forever, tiles weekly and
# read by range.
#
# Behind Cloudflare Tunnel: cloudflared hands requests over plain HTTP on localhost:80 and
# Cloudflare has the certificate.

{
	servers {
	# everything comes from cloudflared, so take the visitor from CF-Connecting-IP
	# (Cloudflare overwrites any a visitor sends)
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers CF-Connecting-IP
	}
}

http://speedmap.gr {
	encode zstd gzip

	# same origin, no CORS. Prefix stripped, the app doesn't know where it's mounted
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000 {
		# the API rate limits on this
			header_up X-Forwarded-For {client_ip}
		# a live probe waits on the operator's checker, the app gives up first
			transport http {
				response_header_timeout 30s
			}
		}
	}

	# one file read by range, swapped by rename. A week and no hash in the name, a client
	# holding an old cached range would splice the two
	handle /tiles/* {
		header Cache-Control "public, max-age=604800"
		header Access-Control-Allow-Origin "*"
		# the directory above the archives, handle keeps /tiles
		root * /srv/speedmap
		file_server {
			precompressed
		}
	}

		# hashed names, held forever
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/speedmap/web
		# web/scripts/compress.mjs
		file_server {
			precompressed br gzip
		}
	}

	# every route gets index.html, so a direct link or reload never 404s
	handle {
		header Cache-Control "no-cache"
		root * /srv/speedmap/web
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		# two weeks, the privacy page promises it
		output file /var/log/caddy/speedmap.log {
			roll_keep_for 336h
		}
		# q is dropped (it's a street someone lives on) and the IP loses its last part, enough
		# to spot a network hammering us but not a house
		format filter {
			fields {
				request>uri query {
					delete q
				}
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>X-Forwarded-For delete
			}
			wrap json
		}
	}
}

# Rate limiting probe and report here needs the caddy-ratelimit plugin. Until then only the
# app limits them.
