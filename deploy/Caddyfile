# The one process in front of everything: built pages, the API and the tiles.
#
# Three jobs, three caching stories, hence three rules. Pages change every deploy and are never
# held. The hashed assets beside them never change and are held forever. The tile archive
# changes weekly, is tens of MB, and gets read by range request.
#
# Replace the site address with the real host. Caddy fetches its own certificate.

speedmap.gr {
	encode zstd gzip

	# The API on the same origin, so there's no CORS to set up and nothing to get wrong about
	# credentials. The prefix is stripped because the app doesn't know where it's mounted.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# a live probe waits on the operator's checker, slow and sometimes silent, and the
			# app gives up before this does
			transport http {
				response_header_timeout 30s
			}
		}
	}

	# One file, read by range request. It's replaced by atomic rename, so a reader gets the old
	# archive or the new one, never half. A client holding a cached range of the old one would
	# splice the two together, though, so this is a week and the name carries no hash.
	handle /tiles/* {
		header Cache-Control "public, max-age=604800"
		header Access-Control-Allow-Origin "*"
		# handle keeps the /tiles prefix, so this is the directory above the archives
		root * /srv/speedmap
		file_server {
			precompressed
		}
	}

	# everything the build hashed into its name: same bytes forever, so held forever
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/speedmap/web
		# compressed once at build time (web/scripts/compress.mjs)
		file_server {
			precompressed br gzip
		}
	}

	# The pages. Every route (/, /en/, /map, /en/map) gets the same document, so arriving
	# directly on a route or reloading one serves the app, never a 404.
	handle {
		header Cache-Control "no-cache"
		root * /srv/speedmap/web
		try_files {path} /index.html
		file_server
	}

	header {
		# the pages load nothing from elsewhere: no basemap, fonts or analytics
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/speedmap.log
		# the query string holds what people searched for, which is a street they live on
		format json
	}
}

# Rate limiting the two endpoints that call out (POST /api/addresses/*/probe and POST
# /api/reports) needs caddy-ratelimit, a build-time plugin that doesn't ship with Caddy. Until
# that build exists only the app refuses, per operator and per address but not per caller.
