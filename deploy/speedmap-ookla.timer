[Unit]
Description=speedmap.gr quarterly measurement refresh

[Timer]
# Weekly, though the load does nothing until a new quarter appears. Looking often is cheaper
# than guessing their release date, and a late quarter still gets picked up.
OnCalendar=Sun *-*-* 05:00:00
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
