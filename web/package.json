{
  "name": "speedmap-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../schema/openapi.json -o src/api/schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^24.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
